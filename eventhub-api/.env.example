# Database
DATABASE_URL=postgresql+asyncpg://eventhub:eventhub_pass@localhost:5432/eventhub

# JWT
SECRET_KEY=change-me-to-a-random-256-bit-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP (use Mailtrap or similar for dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM=noreply@eventhub.dev

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# AWS S3 (optional — for banner image uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=eventhub-images

# Environment
ENVIRONMENT=development
